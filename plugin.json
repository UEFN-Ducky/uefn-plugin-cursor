{
  "id": "cursor",
  "kind": "plugin",
  "version": "1.0.33",
  "label": "Cursor",
  "description": "Cursor API key + Cursor coding agent for Settings \u2192 LLMs. Install from Store \u2192 Gateways, then enable to show Cursor under Providers.",
  "min_app_version": "1.2.45",
  "default_enabled": true,
  "secret_keys": [
    "cursor"
  ],
  "contributes": {
    "llm.providers": [
      {
        "id": "cursor",
        "label": "Cursor",
        "kind": "secret",
        "secret_key": "cursor",
        "order": 5
      }
    ],
    "llm.coding_agents": [
      {
        "id": "cursor",
        "label": "Cursor",
        "order": 80
      }
    ],
    "ide.hookups": [
      {
        "kind": "cursor",
        "label": "Cursor"
      }
    ],
    "walkthrough": {
      "id": "cursor",
      "title": "Set up Cursor",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "steps": [
        {
          "target": "settings.llms.provider.cursor",
          "title": "Open Cursor",
          "body": "Press the Cursor row in this table. The page slides open so you can paste a key or use the Cursor coding agent.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "API key or Cursor agent",
          "body": "Paste your Cursor API key here to use Cursor models in Ducky chats. No key? Skip this and use the Cursor coding agent on this same slide.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save after you paste a key. Using the Cursor agent without a key? Press Skip.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.ide",
          "title": "IDE / MCP connection",
          "body": "IDE / MCP applies UEFN MCP and Ducky skills into Cursor globally. Apply, then Test. Green check means Cursor is connected.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.ide.apply",
          "title": "Apply connection",
          "body": "Press Apply (or Re-apply) so UEFN MCP and Ducky skills land in Cursor. Then Test \u2014 a green check means connected.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent",
          "title": "Cursor agent",
          "body": "This is the Cursor coding agent. Detect finds the CLI. Keep it on to pick Cursor in chat.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent.detect",
          "title": "Detect CLI",
          "body": "Press Detect to find the Cursor CLI on this machine. Leave the toggle on so it appears in the chat picker.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.back",
          "title": "Back",
          "body": "Press Back to return to the provider list.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    },
    "automations": {
      "nodes": [
        {
          "id": "cursor.complete",
          "label": "Cursor complete",
          "group": "Cursor",
          "description": "One-shot prompt through the Cursor gateway. Writes text onto the run.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "model",
              "provider": "cursor"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "cursor-complete",
          "label": "Cursor complete",
          "icon": "\u2728",
          "systems": [
            "pipeline"
          ],
          "description": "Chat prompt through Cursor, then finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat",
                "description": ""
              },
              {
                "id": "c",
                "type": "cursor.complete",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Complete",
                "description": ""
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": {},
                "label": "Finish",
                "description": ""
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "c",
                "kind": "main"
              },
              {
                "source": "c",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
